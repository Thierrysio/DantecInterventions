<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DantecInterventions_.Vues.InterventionVue"
             Title="Interventions">

    <Grid Padding="16" RowSpacing="10"
          RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <Label Text="DantecInterventions" FontSize="36" />
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Interventions}"
                        SelectedItem="{Binding InterventionSelectionnee, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto,Auto">
                        <Label Text="{Binding Titre}" />
                        <Label Grid.Row="1" Text="{Binding Priorite}" />
                        <Label Grid.Row="2" Text="{Binding NomTechnicien, StringFormat='Technicien : {0}'}" />
                        <CheckBox Grid.Column="1" Grid.RowSpan="3"
                                  IsChecked="{Binding EstTerminee, Mode=OneWay}"
                                  IsEnabled="False" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Entry Grid.Row="2" Text="{Binding NouveauTitre}"
               Placeholder="Titre de la nouvelle intervention" />
        <Entry Grid.Row="3" Text="{Binding NomTechnicien}"
               Placeholder="Nom du technicien" />
        <HorizontalStackLayout Grid.Row="4" Spacing="10">
            <Button Text="Ajouter" Command="{Binding AjouterInterventionCommand}" />
            <Button Text="Marquer terminée" Command="{Binding TerminerInterventionCommand}" />
        </HorizontalStackLayout>
        <Label Grid.Row="5" Text="{Binding Message}" />
    </Grid>

</ContentPage>
